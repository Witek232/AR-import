---
import { useTranslations, localePath, TRANSLATED_PATHS } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const syntezaHref = localePath('/synteza-wiary-i-rozumu', lang, {
  translatedPaths: TRANSLATED_PATHS,
});
---
<section
  id="o-projekcie"
  style="background:#F5EDD8; padding:6rem 2rem; position:relative; overflow:hidden;"
>
  <div style="position:absolute; right:-5rem; top:50%; transform:translateY(-50%); opacity:0.04; pointer-events:none;">
    <svg width="500" height="500" viewBox="0 0 500 500" fill="none">
      <circle cx="250" cy="250" r="240" stroke="#1A1209" stroke-width="1" />
      <circle cx="250" cy="250" r="200" stroke="#1A1209" stroke-width="1" />
      <circle cx="250" cy="250" r="160" stroke="#1A1209" stroke-width="1" />
      <polygon points="250,30 470,195 385,440 115,440 30,195" stroke="#1A1209" stroke-width="1" fill="none" />
      <polygon points="250,80 420,205 360,400 140,400 80,205" stroke="#C9A84C" stroke-width="0.5" fill="none" />
    </svg>
  </div>

  <div style="max-width:1100px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:center; gap:4rem;">
    <div style="flex:1; min-width:300px;">
      <p class="reveal" style="font-family:'Inter',serif; font-size:0.7rem; letter-spacing:0.35em; text-transform:uppercase; color:rgba(201,168,76,0.7); margin-bottom:1rem;">
        {t('oprojekcie.label')}
      </p>
      <h2 class="reveal section-title" style="font-size:clamp(2.2rem,4.5vw,3.5rem); color:#1A1209; line-height:1.15; margin-bottom:1.5rem;">
        {t('oprojekcie.title1')}<br />{t('oprojekcie.title2')}
      </h2>
      <div class="ornament reveal" style="max-width:200px; margin-bottom:2rem;">
        <svg width="12" height="12" viewBox="0 0 12 12" fill="#C9A84C">
          <path d="M6 0l1.5 3.5L11 5 8.5 7.5l.5 3.5L6 9l-3 2 .5-3.5L1 5l3.5-1.5L6 0z" />
        </svg>
      </div>
      <p class="reveal" style="font-family:'Inter',serif; font-size:1.15rem; line-height:1.85; color:#4A3A28; margin-bottom:1.5rem;">
        {t('oprojekcie.p1')}
      </p>
      <p class="reveal" style="font-family:'Inter',serif; font-size:1.15rem; line-height:1.85; color:#4A3A28; margin-bottom:2rem;">
        {t('oprojekcie.p2')}
      </p>
      <blockquote class="reveal elegant-quote" style="border-color:#C9A84C; margin-left:0;">
        {t('oprojekcie.quote')}
      </blockquote>
      <a href={syntezaHref}
        class="reveal"
        style="display:inline-block; margin-top:1.5rem; font-family:'Inter',serif; font-size:0.85rem; letter-spacing:0.15em; text-transform:uppercase; color:#1A1209; text-decoration:none; border-bottom:1px solid #C9A84C; padding-bottom:2px; transition:color 0.2s;"
      >
        {t('oprojekcie.readMore')}
      </a>
    </div>

    <div class="reveal" style="flex:0 0 300px; display:flex; justify-content:center; align-items:center;">
      <img src="https://res.cloudinary.com/dmb0xngy0/image/upload/v1779483013/logoAR_imprmp.svg" alt="Ateny Roztocza logo" style="width:100%; max-width:300px; height:auto; opacity:0.9;">
    </div>
  </div>
</section>
