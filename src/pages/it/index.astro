---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/i18n/Hero.astro';
import Filary from '../../components/i18n/Filary.astro';
import OProjekcie from '../../components/i18n/OProjekcie.astro';
import KsGuzTeaser from '../../components/i18n/KsGuzTeaser.astro';
import WydarzeniaTeaser from '../../components/i18n/WydarzeniaTeaser.astro';
import Wsparcie from '../../components/i18n/Wsparcie.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const lang = 'it' as Lang;
const t = useTranslations(lang);
---
<Layout
  title={t('meta.homeTitle')}
  description={t('meta.homeDescription')}
  lang={lang}
>
  <div class="page-transition">
    <Hero lang={lang} />
    <Filary lang={lang} />
    <OProjekcie lang={lang} />
    <KsGuzTeaser lang={lang} />
    <WydarzeniaTeaser lang={lang} />
    <Wsparcie lang={lang} />
  </div>
</Layout>
